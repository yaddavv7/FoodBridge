rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isVerifiedNgo() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ngo' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verified == true;
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Users can only create their own document and CANNOT elevate their role to 'admin'
      allow create: if isOwner(userId) && request.resource.data.role != 'admin';
      // Only admins can alter the 'role' or 'verified' status
      allow update: if isOwner(userId) && 
                      request.resource.data.role == resource.data.role &&
                      request.resource.data.verified == resource.data.verified
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // DONATIONS COLLECTION
    match /donations/{donationId} {
      allow read: if true; // Public listings show obfuscated addresses
      allow create: if isAuthenticated() && request.resource.data.donorId == request.auth.uid;
      
      // Donors can update their unaccepted listings.
      // Matched NGOs and assigned couriers can update delivery progression tokens.
      // Completed transactions are immutable except by admins.
      allow update: if (isAuthenticated() && (
                          resource.data.donorId == request.auth.uid ||
                          resource.data.matchedNgoId == request.auth.uid ||
                          resource.data.assignedVolunteerId == request.auth.uid
                        ) && resource.data.status != 'VERIFIED')
                    || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.donorId == request.auth.uid && resource.data.status == 'LISTED')
                    || isAdmin();
    }

    // VOLUNTEER DELIVERY TASKS
    match /pickupTasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
                      resource.data.assignedVolunteerId == null ||
                      resource.data.assignedVolunteerId == request.auth.uid
                    ) || isAdmin();
      allow delete: if isAdmin();
    }

    // SAFETY REPORTS
    match /safetyReports/{reportId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.reportedBy == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // NOTIFICATIONS
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // AUDIT LOGS
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
